{
  "portal": "Entra IDGov",
  "url": "https://entra.microsoft.com/#blade/Microsoft_AAD_ERM/DashboardBlade",
  "pageTarget": {
    "matchHosts": ["entra.microsoft.com"],
    "matchPathPrefixes": ["/"],
    "bootstrap": {
      "matchHosts": ["entra.microsoft.com"],
      "matchPathnames": ["/"]
    }
  },
  "noveltyFrontier": {
    "baseline": "checked-in-spec-and-coverage-ledgers",
    "baselineSignals": { "queryMetadata": [], "requestShapes": [], "responseShapes": [], "routes": [] },
    "targets": [
      {
        "id": "provider-and-partner-settings-shapes",
        "state": "Programs and governance settings states",
        "evidenceLevel": "confirmed",
        "expectedHostFamilies": ["api.accessreviews.identitygovernance.azure.com"],
        "expectedRoutePrefixes": ["/accessReviews/v2.0/approvalWorkflowProviders"],
        "expectedInformationClasses": ["response-shape", "response-metadata", "query-metadata"],
        "actionIndexes": [3, 4, 5, 9, 10, 11],
        "safeAction": "Open provider/program and settings pages without changing governance configuration.",
        "acceptanceKey": "provider-settings-shape-gap",
        "rationale": "Provider partner settings and feature metadata remain opaque or example-free."
      },
      {
        "id": "review-request-hierarchy",
        "state": "Access reviews and review-history request states",
        "evidenceLevel": "confirmed",
        "expectedHostFamilies": ["api.accessreviews.identitygovernance.azure.com"],
        "expectedRoutePrefixes": ["/accessReviews/v2.0/approvalWorkflowProviders", "/accessReviews/v2.0/reports"],
        "expectedInformationClasses": ["new-route-family", "response-shape"],
        "actionIndexes": [0, 1, 2, 6, 7, 8],
        "safeAction": "Open read-only review lists and history without stopping, applying, resetting, or creating reviews.",
        "acceptanceKey": "request-instance-decision-hierarchy",
        "rationale": "Request, instance, and decision detail shapes are the explicit deeper workflow-state frontier."
      }
    ]
  },
  "matchHosts": [
    "entra.microsoft.com",
    "api.accessreviews.identitygovernance.azure.com"
  ],
  "matchPathPrefixes": [
    "/accessReviews"
  ],
  "postActionSettleMs": 10000,
  "settleMs": 12000,
  "actions": [
    "click-label-iframe=Access reviews",
    "wait-ms=6000",
    "capture=access-reviews",
    "click-label-root=Programs",
    "wait-ms=6000",
    "capture=programs",
    "click-label-root=Review History",
    "wait-ms=6000",
    "capture=review-history",
    "click-label-root=Settings",
    "wait-ms=6000",
    "capture=settings"
  ]
}
