{
  "portal": "Viva Engage",
  "url": "https://engage.cloud.microsoft/main/admin",
  "pageTarget": {
    "matchHosts": ["engage.cloud.microsoft"],
    "matchPathPrefixes": ["/main/admin/external-networks-settings"],
    "bootstrap": {
      "matchHosts": ["engage.cloud.microsoft"],
      "matchPathnames": ["/main/admin"]
    }
  },
  "matchHosts": [
    "engage.cloud.microsoft",
    "api.engage.cloud.microsoft",
    "www.yammer.com",
    "msgraph.yammer.com",
    "broadcast.yammer.com",
    "*.rt.yammer.com"
  ],
  "postActionSettleMs": 12000,
  "settleMs": 14000,
  "actions": [
    "capture=admin-landing",
    "navigate=/main/admin/external-networks-settings",
    "capture=external-networks-settings"
  ]
}
