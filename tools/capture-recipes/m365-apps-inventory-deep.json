{
  "portal": "M365 Apps Inventory",
  "maxActions": 33,
  "url": "https://config.office.com/officeSettings",
  "matchHosts": [
    "config.office.com",
    "query.inventory.insights.office.net"
  ],
  "matchPathPrefixes": [
    "/inventory"
  ],
  "pageTarget": {
    "matchHosts": [
      "config.office.com"
    ],
    "matchPathPrefixes": [
      "/officeSettings/inventory"
    ],
    "bootstrap": {
      "matchHosts": [
        "config.office.com"
      ],
      "matchPathnames": [
        "/officeSettings"
      ]
    }
  },
  "postActionSettleMs": 10000,
  "settleMs": 12000,
  "actions": [
    "navigate=https://config.office.com/officeSettings/inventory",
    "wait-ms=6000",
    "capture=inventory",
    "click-label-root=Show all builds",
    "wait-ms=6000",
    "navigate=https://config.office.com/officeSettings/inventory",
    "click-label-root=Show all channels",
    "wait-ms=6000",
    "navigate=https://config.office.com/officeSettings/inventory",
    "click-label-root=Show all devices",
    "wait-ms=6000",
    "navigate=https://config.office.com/officeSettings/inventory",
    "click-label-root=Show all add-ins",
    "wait-ms=6000",
    "capture=inventory-addins",
    "navigate=https://config.office.com/officeSettings/cloudUpdate",
    "wait-ms=6000",
    "capture=cloud-update",
    "navigate=https://config.office.com/officeSettings/securityUpdate",
    "wait-ms=6000",
    "capture=security-update-status",
    "navigate=https://config.office.com/officeSettings/health",
    "wait-ms=6000",
    "capture=health",
    "navigate=https://config.office.com/officeSettings/setup",
    "wait-ms=6000",
    "capture=setup",
    "navigate=https://config.office.com/officeSettings/inventory/addins",
    "navigate=https://config.office.com/officeSettings/inventory/addins/devices",
    "navigate=https://config.office.com/officeSettings/inventory/devices",
    "navigate=https://config.office.com/officeSettings/inventory/devices/addins",
    "wait-ms=6000"
  ]
}
