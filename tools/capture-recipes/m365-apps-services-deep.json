{
  "portal": "M365 Apps Services",
  "url": "https://config.office.com/officeSettings",
  "pageTarget": {
    "matchHosts": ["config.office.com"],
    "matchPathPrefixes": ["/officeSettings"],
    "bootstrap": {
      "matchHosts": ["config.office.com"],
      "matchPathnames": ["/officeSettings"]
    }
  },
  "noveltyFrontier": {
    "baseline": "checked-in-spec-and-live-capture-ledgers",
    "baselineSignals": { "queryMetadata": [], "requestShapes": [], "responseShapes": [], "routes": [] },
    "targets": [
      {
        "id": "onedrive-health-count-shapes",
        "state": "Health and OneDrive sync report states",
        "evidenceLevel": "confirmed",
        "expectedHostFamilies": ["config.office.com", "clients.config.office.net"],
        "expectedRoutePrefixes": ["/odbhealth"],
        "expectedInformationClasses": ["new-route-family", "response-shape", "query-metadata"],
        "actionIndexes": [0, 1, 2, 3, 4, 5],
        "safeAction": "Open read-only health and OneDrive sync report states without exporting data.",
        "acceptanceKey": "onedrive-health-route-shape-or-count-metadata",
        "rationale": "OneDrive health count and report variants remain underrepresented in the nine-operation spec."
      },
      {
        "id": "onboarding-release-feature-state",
        "state": "Cloud update, customization, and setup states",
        "evidenceLevel": "confirmed",
        "expectedHostFamilies": ["config.office.com", "clients.config.office.net"],
        "expectedRoutePrefixes": ["/intents", "/onboarding", "/releases"],
        "expectedInformationClasses": ["new-route-family", "response-shape", "response-metadata"],
        "actionIndexes": [6, 7, 8, 9, 10, 11, 12, 13, 14],
        "safeAction": "Visit read-only service onboarding, release, and setup states without submitting changes.",
        "acceptanceKey": "service-feature-state-or-release-shape",
        "rationale": "Eligibility, agreement, onboarding, and release feature-state metadata are not comprehensively documented."
      }
    ]
  },
  "matchHosts": [
    "config.office.com",
    "clients.config.office.net"
  ],
  "matchPathPrefixes": [
    "/intents",
    "/odbhealth",
    "/onboarding",
    "/releases"
  ],
  "postActionSettleMs": 10000,
  "settleMs": 12000,
  "actions": [
    "navigate=https://config.office.com/officeSettings/health",
    "wait-ms=6000",
    "capture=health",
    "navigate=https://config.office.com/officeSettings/oneDrive",
    "wait-ms=6000",
    "capture=onedrive-sync",
    "navigate=https://config.office.com/officeSettings/cloudUpdate",
    "wait-ms=6000",
    "capture=cloud-update",
    "navigate=https://config.office.com/officeSettings/customization",
    "wait-ms=6000",
    "capture=customization",
    "navigate=https://config.office.com/officeSettings/setup",
    "wait-ms=6000",
    "capture=setup"
  ]
}
