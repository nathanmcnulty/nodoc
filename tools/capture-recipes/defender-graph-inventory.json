{
  "portal": "Defender",
  "url": "https://security.microsoft.com",
  "pageTarget": {
    "matchHosts": ["security.microsoft.com"],
    "matchPathPrefixes": ["/user"],
    "allowedEntryQueryParameters": ["aad", "tab", "tid"],
    "bootstrap": {
      "matchHosts": ["security.microsoft.com"],
      "matchPathnames": ["/"]
    }
  },
  "capturePrerequisite": {
    "status": "blocked",
    "reason": "Identity Explorer is now the deterministic non-baseline Defender Graph state, but the revised parameterized frontier has not yet received the required exact Luna xhigh/max review artifact.",
    "nextRequirement": "Have exact gpt-5.6-luna at xhigh or max approve the parameterized aad/tab/tid Identity Explorer frontier and bind its immutable approval artifact before supplying runtime aad and tenantId variables."
  },
  "matchHosts": ["security.microsoft.com", "mto.security.microsoft.com"],
  "matchPathPrefixes": ["/apiproxy"],
  "captureScripts": false,
  "graphTelemetryObjectives": {
    "contractRequired": true,
    "minimumOperationCount": 2,
    "minimumNewOperationCount": 1,
    "minimumProxyOperationCount": 1,
    "minimumEnrichedOperationCount": 1,
    "minimumCheckpointCount": 1,
    "minimumNewEnrichedProductOperationCount": 1,
    "productProxyOnly": true,
    "productExcludeOperationKeys": [
      "v1.0 GET /admin/serviceAnnouncement/messages",
      "v1.0 GET /users/{id}/photo/$value"
    ],
    "baselineOperationKeys": [
      "v1.0 GET /subscribedSkus",
      "v1.0 GET /users",
      "v1.0 GET /users/{id}"
    ]
  },
  "postActionSettleMs": 8000,
  "settleMs": 10000,
  "actions": [
    {
      "type": "navigate",
      "value": "https://security.microsoft.com/user?aad=${aad}&tab=huntingGraph&tid=${tenantId}",
      "required": true,
      "highValue": true
    },
    "wait-ms=10000",
    "capture=defender-identity-explorer"
  ]
}
