{
  "portal": "Intune Portal",
  "url": "https://intune.microsoft.com",
  "pageTarget": {
    "matchHosts": ["intune.microsoft.com"],
    "matchPathPrefixes": ["/"]
  },
  "matchHosts": ["intune.microsoft.com"],
  "matchPathPrefixes": ["/api"],
  "graphTelemetryObjectives": {
    "contractRequired": true,
    "minimumOperationCount": 12,
    "minimumNewOperationCount": 3,
    "minimumBatchMemberCount": 1,
    "minimumEnrichedOperationCount": 4,
    "minimumCheckpointCount": 5,
    "baselineOperationKeys": [
      "beta GET /deviceAppManagement/vppTokens",
      "beta GET /deviceManagement",
      "beta GET /deviceManagement/AdminConsent",
      "beta GET /deviceManagement/androidManagedStoreAccountEnterpriseSettings",
      "beta GET /deviceManagement/applePushNotificationCertificate",
      "beta GET /deviceManagement/depOnboardingSettings",
      "beta GET /deviceManagement/deviceManagementPartners/{id}",
      "beta GET /deviceManagement/getEffectivePermissions",
      "beta GET /deviceManagement/getEffectivePermissions(scope='*')",
      "beta GET /deviceManagement/managedDeviceOverview",
      "beta GET /deviceManagement/mobileThreatDefenseConnectors",
      "beta GET /deviceManagement/ndesConnectors",
      "beta GET /deviceManagement/retrieveProjectFlightingStatuses(projectNames=null)",
      "beta GET /deviceManagement/subscriptionState",
      "beta GET /deviceManagement/userExperienceAnalyticsBaselines",
      "beta GET /deviceManagement/userExperienceAnalyticsDevicePerformance",
      "beta GET /deviceManagement/userExperienceAnalyticsDeviceScopes",
      "beta GET /deviceManagement/userExperienceAnalyticsOverview",
      "beta GET /deviceManagement/virtualEndpoint/getEffectivePermissions",
      "beta GET /deviceManagement/virtualEndpoint/onPremisesConnections",
      "beta GET /deviceManagement/windowsAutoPilotSettings",
      "beta GET /me",
      "beta GET /organization('{id}')",
      "beta GET /rolemanagement/directory/transitiveRoleAssignments",
      "beta GET /servicePrincipals/appId={appId}/endpoints",
      "beta GET /subscribedSkus",
      "beta POST /deviceManagement/roleScopeTags/getRoleScopeTagsById"
    ]
  },
  "postActionSettleMs": 8000,
  "settleMs": 10000,
  "actions": [
    "click-label-root=Tenant administration",
    "wait-ms=6000",
    "capture=intune-tenant-administration",
    "click-label-root=Reports",
    "wait-ms=6000",
    "capture=intune-reports",
    "click-contains-root=Endpoint analytics",
    "wait-ms=6000",
    "capture=intune-endpoint-analytics",
    "click-label-root=Devices",
    "wait-ms=6000",
    "capture=intune-devices",
    "click-label-root=Apps",
    "wait-ms=6000",
    "capture=intune-apps"
  ]
}
